      "beat_id": "B01",
      "act": "the starting point",
      "content_type": "structure",
      "narration_text": "Start with three scores: one, two, and three. The course calls them logits. They rank the outcomes, but they are not yet probabilities. Probabilities have to be non-negative and sum to one. These sum to six. And dividing by six is not the transformation we want — it would break on a negative score.",
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "lane": "remotion",
        "motion": "kinetic",
        "show": [
          {
            "at": 0.1,
            "event": "three score tiles rise in sequence"
          },
          {
            "at": 0.45,
            "event": "the two conditions a distribution must meet appear"
          },
          {
            "at": 0.7,
            "event": "'these sum to 6' is struck through in accent"
          }
        ],
        "remotion": {
          "pattern": "TempScores",
          "props": {
            "labels": [
              "A",
              "B",
              "C"
            ],
            "scores": [
